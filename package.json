{
  "name": "textpup-service",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=web && npm run build --workspace=server",
    "typecheck": "npm run typecheck --workspace=web && npm run typecheck --workspace=server",
    "test": "npm run test --workspace=server",
    "start": "npm run start --workspace=server"

  },
  "devDependencies": {
    "prettier": "^3.5.1"
  }
}
