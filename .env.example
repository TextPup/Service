# ==============================================================================
# TextPup Service Environment Configuration
# ==============================================================================

# External port mapping on the host (default: 8080)
PORT=8080

# WebAuthn Passkeys Configuration
# Note: WebAuthn requires localhost or HTTPS (via reverse proxy, Cloudflare, Caddy, etc.)
#
# Example for Local / Tailscale Testing:
# RP_ID=localhost
# RP_ORIGIN=http://localhost:8080
#
# Example for Production Domain with HTTPS:
# RP_ID=sms.yourdomain.com
# RP_ORIGIN=https://sms.yourdomain.com
RP_ID=localhost
RP_ORIGIN=http://localhost:8080

# First-Run Setup Token
# If left blank, TextPup auto-generates a secure 32-character random token
# and outputs it to the server console log on initial boot.
# You can set a custom bootstrap token here if preferred:
APP_SETUP_TOKEN=

# Cryptographic Vault Auto-Lock (in minutes)
# Automatically wipes active encryption keys from RAM after N minutes of inactivity.
# Set to 0 to keep the vault unlocked until manual lock or server restart.
VAULT_AUTO_LOCK_MINUTES=30

# Web Push Notification VAPID Keys (Optional)
# If left blank, TextPup will auto-generate and store unique VAPID keys in SQLite.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
