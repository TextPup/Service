# ==============================================================================
# TextPup Environment Configuration
# ==============================================================================

# Database passwords for the SMSGate MariaDB backing store
MARIADB_ROOT_PASSWORD=replace_with_secure_root_password
MARIADB_PASSWORD=replace_with_secure_user_password

# Authentication token for SMSGate private mode (used by host Android APK)
GATEWAY_PRIVATE_TOKEN=replace_with_secure_gateway_private_token

# TextPup First-Run Setup Token
# If left blank or unset, TextPup will auto-generate a 32-character random token
# and print it to stdout on first startup.
APP_SETUP_TOKEN=

# WebAuthn Relying Party configuration
# Set RP_ID to your domain name (or localhost in dev)
# Set RP_ORIGIN to your complete origin URL including protocol and port if non-standard
RP_ID=localhost
RP_ORIGIN=http://localhost:8080

# Port and storage path for TextPup
PORT=8080
DATA_DIR=/data
